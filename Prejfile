setup:
  git-pull:  # this is a namespace task
    cmd: git # define the main command that this task runs
    args:    # pass args to this task's command
      - pull
      - origin

demand:
  build:
    cmd: cargo
    args:
      - build

  install:
    cmd: cp
    args:
      - ./target/debug/prej
      - /usr/local/bin/prej
    flags:
      - sudo
    depends:
      - build

  test:
    cmd: echo
    args:
      - "test"

close:
  git-push:
    cmd: git
    args:
      - push

foo:
  bar:
    cmd: echo
    args:
      - "test"